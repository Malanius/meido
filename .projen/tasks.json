{
  "manifestVersion": 3,
  "env": {
    "PATH": "$(bun --eval \"console.log(process.env.PATH)\")"
  },
  "tasks": {
    "biome": {
      "name": "biome",
      "description": "Runs Biome against the codebase",
      "steps": [
        {
          "execArgs": [
            "biome",
            "check",
            "--no-errors-on-unmatched",
            "--write"
          ],
          "receiveArgs": true
        }
      ]
    },
    "build": {
      "name": "build",
      "description": "Full release build",
      "steps": [
        {
          "spawn": "default"
        },
        {
          "spawn": "pre-compile"
        },
        {
          "spawn": "compile"
        },
        {
          "spawn": "post-compile"
        },
        {
          "spawn": "test"
        },
        {
          "spawn": "package"
        }
      ]
    },
    "bump": {
      "name": "bump",
      "description": "Bumps version based on latest git tag and generates a changelog entry",
      "env": {
        "OUTFILE": "package.json",
        "CHANGELOG": "dist/changelog.md",
        "BUMPFILE": "dist/version.txt",
        "RELEASETAG": "dist/releasetag.txt",
        "RELEASE_TAG_PREFIX": "",
        "BUMP_PACKAGE": "commit-and-tag-version@^13"
      },
      "steps": [
        {
          "builtin": "release/resolve-latest-tag",
          "outputEnv": "LATEST_TAG"
        },
        {
          "spawn": "bump:releasable-commits",
          "outputEnv": "RELEASABLE_COMMITS",
          "condition": "git rev-parse --verify --quiet \"refs/tags/$LATEST_TAG\""
        },
        {
          "builtin": "release/suggest-version-bump",
          "outputEnv": "SUGGESTED_BUMP"
        },
        {
          "builtin": "release/apply-version-bump"
        }
      ],
      "condition": "git log --oneline -1 | grep -v \"chore(release):\" > /dev/null"
    },
    "bump:releasable-commits": {
      "name": "bump:releasable-commits",
      "description": "Print the releasable commits since the latest release",
      "steps": [
        {
          "exec": "git log --oneline $LATEST_TAG..HEAD"
        }
      ]
    },
    "bundle": {
      "name": "bundle",
      "description": "Prepare assets",
      "steps": [
        {
          "spawn": "bundle:tadaima/tadaima.lambda"
        },
        {
          "spawn": "bundle:core/interaction-handler/interaction-handler.lambda"
        },
        {
          "spawn": "bundle:journal/broadcaster/brodcast-handler.lambda"
        },
        {
          "spawn": "bundle:journal/subscription-manager/subscription-manager.lambda"
        },
        {
          "spawn": "bundle:shared/discord-slash-command/register-slash-command.lambda"
        }
      ]
    },
    "bundle:core/interaction-handler/interaction-handler.lambda": {
      "name": "bundle:core/interaction-handler/interaction-handler.lambda",
      "description": "Create a JavaScript bundle from src/core/interaction-handler/interaction-handler.lambda.ts",
      "steps": [
        {
          "execArgs": [
            "esbuild",
            "--bundle",
            "src/core/interaction-handler/interaction-handler.lambda.ts",
            "--target=node24",
            "--platform=node",
            "--outfile=assets/core/interaction-handler/interaction-handler.lambda/index.js",
            "--packages=bundle",
            "--tsconfig=test/tsconfig.json",
            "--sourcemap"
          ]
        }
      ]
    },
    "bundle:core/interaction-handler/interaction-handler.lambda:watch": {
      "name": "bundle:core/interaction-handler/interaction-handler.lambda:watch",
      "description": "Continuously update the JavaScript bundle from src/core/interaction-handler/interaction-handler.lambda.ts",
      "steps": [
        {
          "execArgs": [
            "esbuild",
            "--bundle",
            "src/core/interaction-handler/interaction-handler.lambda.ts",
            "--target=node24",
            "--platform=node",
            "--outfile=assets/core/interaction-handler/interaction-handler.lambda/index.js",
            "--packages=bundle",
            "--tsconfig=test/tsconfig.json",
            "--sourcemap",
            "--watch"
          ]
        }
      ]
    },
    "bundle:journal/broadcaster/brodcast-handler.lambda": {
      "name": "bundle:journal/broadcaster/brodcast-handler.lambda",
      "description": "Create a JavaScript bundle from src/journal/broadcaster/brodcast-handler.lambda.ts",
      "steps": [
        {
          "execArgs": [
            "esbuild",
            "--bundle",
            "src/journal/broadcaster/brodcast-handler.lambda.ts",
            "--target=node24",
            "--platform=node",
            "--outfile=assets/journal/broadcaster/brodcast-handler.lambda/index.js",
            "--packages=bundle",
            "--tsconfig=test/tsconfig.json",
            "--sourcemap"
          ]
        }
      ]
    },
    "bundle:journal/broadcaster/brodcast-handler.lambda:watch": {
      "name": "bundle:journal/broadcaster/brodcast-handler.lambda:watch",
      "description": "Continuously update the JavaScript bundle from src/journal/broadcaster/brodcast-handler.lambda.ts",
      "steps": [
        {
          "execArgs": [
            "esbuild",
            "--bundle",
            "src/journal/broadcaster/brodcast-handler.lambda.ts",
            "--target=node24",
            "--platform=node",
            "--outfile=assets/journal/broadcaster/brodcast-handler.lambda/index.js",
            "--packages=bundle",
            "--tsconfig=test/tsconfig.json",
            "--sourcemap",
            "--watch"
          ]
        }
      ]
    },
    "bundle:journal/subscription-manager/subscription-manager.lambda": {
      "name": "bundle:journal/subscription-manager/subscription-manager.lambda",
      "description": "Create a JavaScript bundle from src/journal/subscription-manager/subscription-manager.lambda.ts",
      "steps": [
        {
          "execArgs": [
            "esbuild",
            "--bundle",
            "src/journal/subscription-manager/subscription-manager.lambda.ts",
            "--target=node24",
            "--platform=node",
            "--outfile=assets/journal/subscription-manager/subscription-manager.lambda/index.js",
            "--packages=bundle",
            "--tsconfig=test/tsconfig.json",
            "--sourcemap"
          ]
        }
      ]
    },
    "bundle:journal/subscription-manager/subscription-manager.lambda:watch": {
      "name": "bundle:journal/subscription-manager/subscription-manager.lambda:watch",
      "description": "Continuously update the JavaScript bundle from src/journal/subscription-manager/subscription-manager.lambda.ts",
      "steps": [
        {
          "execArgs": [
            "esbuild",
            "--bundle",
            "src/journal/subscription-manager/subscription-manager.lambda.ts",
            "--target=node24",
            "--platform=node",
            "--outfile=assets/journal/subscription-manager/subscription-manager.lambda/index.js",
            "--packages=bundle",
            "--tsconfig=test/tsconfig.json",
            "--sourcemap",
            "--watch"
          ]
        }
      ]
    },
    "bundle:shared/discord-slash-command/register-slash-command.lambda": {
      "name": "bundle:shared/discord-slash-command/register-slash-command.lambda",
      "description": "Create a JavaScript bundle from src/shared/discord-slash-command/register-slash-command.lambda.ts",
      "steps": [
        {
          "execArgs": [
            "esbuild",
            "--bundle",
            "src/shared/discord-slash-command/register-slash-command.lambda.ts",
            "--target=node24",
            "--platform=node",
            "--outfile=assets/shared/discord-slash-command/register-slash-command.lambda/index.js",
            "--packages=bundle",
            "--tsconfig=test/tsconfig.json",
            "--sourcemap"
          ]
        }
      ]
    },
    "bundle:shared/discord-slash-command/register-slash-command.lambda:watch": {
      "name": "bundle:shared/discord-slash-command/register-slash-command.lambda:watch",
      "description": "Continuously update the JavaScript bundle from src/shared/discord-slash-command/register-slash-command.lambda.ts",
      "steps": [
        {
          "execArgs": [
            "esbuild",
            "--bundle",
            "src/shared/discord-slash-command/register-slash-command.lambda.ts",
            "--target=node24",
            "--platform=node",
            "--outfile=assets/shared/discord-slash-command/register-slash-command.lambda/index.js",
            "--packages=bundle",
            "--tsconfig=test/tsconfig.json",
            "--sourcemap",
            "--watch"
          ]
        }
      ]
    },
    "bundle:tadaima/tadaima.lambda": {
      "name": "bundle:tadaima/tadaima.lambda",
      "description": "Create a JavaScript bundle from src/tadaima/tadaima.lambda.ts",
      "steps": [
        {
          "execArgs": [
            "esbuild",
            "--bundle",
            "src/tadaima/tadaima.lambda.ts",
            "--target=node24",
            "--platform=node",
            "--outfile=assets/tadaima/tadaima.lambda/index.js",
            "--packages=bundle",
            "--tsconfig=test/tsconfig.json",
            "--sourcemap"
          ]
        }
      ]
    },
    "bundle:tadaima/tadaima.lambda:watch": {
      "name": "bundle:tadaima/tadaima.lambda:watch",
      "description": "Continuously update the JavaScript bundle from src/tadaima/tadaima.lambda.ts",
      "steps": [
        {
          "execArgs": [
            "esbuild",
            "--bundle",
            "src/tadaima/tadaima.lambda.ts",
            "--target=node24",
            "--platform=node",
            "--outfile=assets/tadaima/tadaima.lambda/index.js",
            "--packages=bundle",
            "--tsconfig=test/tsconfig.json",
            "--sourcemap",
            "--watch"
          ]
        }
      ]
    },
    "check": {
      "name": "check",
      "description": "Check the code style and formatting",
      "steps": [
        {
          "exec": "bunx biome check --write"
        }
      ]
    },
    "check:staged": {
      "name": "check:staged",
      "description": "Check the code style and formatting for staged files",
      "steps": [
        {
          "exec": "bunx biome check --write --staged"
        }
      ]
    },
    "clobber": {
      "name": "clobber",
      "description": "hard resets to HEAD of origin and cleans the local repo",
      "env": {
        "BRANCH": "$(git branch --show-current)"
      },
      "steps": [
        {
          "execArgs": [
            "git",
            "checkout",
            "-b",
            "scratch"
          ],
          "name": "save current HEAD in \"scratch\" branch"
        },
        {
          "exec": "git checkout \"$BRANCH\""
        },
        {
          "execArgs": [
            "git",
            "fetch",
            "origin"
          ],
          "name": "fetch latest changes from origin"
        },
        {
          "exec": "git reset --hard \"origin/$BRANCH\"",
          "name": "hard reset to origin commit"
        },
        {
          "execArgs": [
            "git",
            "clean",
            "-fdx"
          ],
          "name": "clean all untracked files"
        },
        {
          "say": "ready to rock! (unpushed commits are under the \"scratch\" branch)"
        }
      ],
      "condition": "git diff --exit-code > /dev/null"
    },
    "compile": {
      "name": "compile",
      "description": "Only compile",
      "steps": [
        {
          "exec": "bun run tsc --project tsconfig.json --noEmit"
        }
      ]
    },
    "default": {
      "name": "default",
      "description": "Synthesize project files",
      "steps": [
        {
          "exec": "bun .projenrc.ts"
        }
      ]
    },
    "deploy": {
      "name": "deploy",
      "description": "Deploys your CDK app to the AWS cloud",
      "steps": [
        {
          "execArgs": [
            "cdk",
            "deploy"
          ],
          "receiveArgs": true
        }
      ]
    },
    "destroy": {
      "name": "destroy",
      "description": "Destroys your cdk app in the AWS cloud",
      "steps": [
        {
          "execArgs": [
            "cdk",
            "destroy"
          ],
          "receiveArgs": true
        }
      ]
    },
    "diff": {
      "name": "diff",
      "description": "Diffs the currently deployed app against your code",
      "steps": [
        {
          "execArgs": [
            "cdk",
            "diff"
          ]
        }
      ]
    },
    "eject": {
      "name": "eject",
      "description": "Remove projen from the project",
      "env": {
        "PROJEN_EJECTING": "true"
      },
      "steps": [
        {
          "spawn": "default"
        }
      ]
    },
    "install": {
      "name": "install",
      "description": "Install project dependencies and update lockfile (non-frozen)",
      "steps": [
        {
          "exec": "bun install"
        }
      ]
    },
    "install:ci": {
      "name": "install:ci",
      "description": "Install project dependencies using frozen lockfile",
      "steps": [
        {
          "exec": "bun install --frozen-lockfile"
        }
      ]
    },
    "package": {
      "name": "package",
      "description": "Creates the distribution package",
      "steps": [
        {
          "execArgs": [
            "mkdir",
            "-p",
            "dist/js"
          ]
        },
        {
          "execArgs": [
            "npm",
            "pack",
            "--pack-destination",
            "dist/js"
          ]
        }
      ]
    },
    "post-compile": {
      "name": "post-compile",
      "description": "Runs after successful compilation",
      "steps": [
        {
          "spawn": "synth:silent"
        }
      ]
    },
    "post-upgrade": {
      "name": "post-upgrade",
      "description": "Runs after upgrading dependencies"
    },
    "pre-compile": {
      "name": "pre-compile",
      "description": "Prepare the project for compilation"
    },
    "prepare": {
      "name": "prepare",
      "description": "Prepare the project for development",
      "steps": [
        {
          "exec": "bunx lefthook install"
        }
      ]
    },
    "publish:git": {
      "name": "publish:git",
      "description": "Prepends the release changelog onto the project changelog, creates a release commit, and tags the release",
      "env": {
        "CHANGELOG": "dist/changelog.md",
        "RELEASE_TAG_FILE": "dist/releasetag.txt",
        "PROJECT_CHANGELOG_FILE": "CHANGELOG.md",
        "VERSION_FILE": "dist/version.txt"
      },
      "steps": [
        {
          "builtin": "release/update-changelog"
        },
        {
          "builtin": "release/tag-version"
        },
        {
          "execArgs": [
            "git",
            "push",
            "--follow-tags",
            "origin",
            "main"
          ]
        }
      ],
      "condition": "git log --oneline -1 | grep -v \"chore(release):\" > /dev/null"
    },
    "release": {
      "name": "release",
      "description": "Prepare a release from \"main\" branch",
      "env": {
        "RELEASE": "true"
      },
      "steps": [
        {
          "execArgs": [
            "rm",
            "-fr",
            "dist"
          ]
        },
        {
          "spawn": "bump"
        },
        {
          "spawn": "build"
        },
        {
          "spawn": "unbump"
        },
        {
          "exec": "git diff --ignore-space-at-eol --exit-code"
        },
        {
          "spawn": "publish:git"
        }
      ],
      "condition": "git log --oneline -1 | grep -v \"chore(release):\" > /dev/null"
    },
    "synth": {
      "name": "synth",
      "description": "Synthesizes your cdk app into cdk.out",
      "steps": [
        {
          "execArgs": [
            "cdk",
            "synth"
          ]
        }
      ]
    },
    "synth:silent": {
      "name": "synth:silent",
      "description": "Synthesizes your cdk app into cdk.out and suppresses the template in stdout (part of \"yarn build\")",
      "steps": [
        {
          "execArgs": [
            "cdk",
            "synth",
            "-q"
          ]
        }
      ]
    },
    "test": {
      "name": "test",
      "description": "Run tests",
      "steps": [
        {
          "spawn": "biome"
        }
      ]
    },
    "unbump": {
      "name": "unbump",
      "description": "Restores version to 0.0.0",
      "env": {
        "OUTFILE": "package.json",
        "CHANGELOG": "dist/changelog.md",
        "BUMPFILE": "dist/version.txt",
        "RELEASETAG": "dist/releasetag.txt",
        "RELEASE_TAG_PREFIX": "",
        "BUMP_PACKAGE": "commit-and-tag-version@^13"
      },
      "steps": [
        {
          "builtin": "release/reset-version"
        }
      ]
    },
    "upgrade": {
      "name": "upgrade",
      "description": "upgrade dependencies",
      "env": {
        "CI": "0"
      },
      "steps": [
        {
          "execArgs": [
            "bunx",
            "npm-check-updates@20",
            "--upgrade",
            "--target=minor",
            "--peer",
            "--no-deprecated",
            "--dep=dev,prod,peer,optional",
            "--filter=@commitlint/config-conventional,@types/aws-lambda,@types/node,commitlint,cz-conventional-changelog,discord-api-types,esbuild,lefthook,projen,ts-node,tsconfig-paths,typescript,@middy/core,axios,axios-retry,tweetnacl"
          ]
        },
        {
          "exec": "bun install"
        },
        {
          "execArgs": [
            "bun",
            "update",
            "@biomejs/biome",
            "@commitlint/config-conventional",
            "@types/aws-lambda",
            "@types/node",
            "aws-cdk",
            "bun-types",
            "commit-and-tag-version",
            "commitlint",
            "cz-conventional-changelog",
            "discord-api-types",
            "esbuild",
            "lefthook",
            "projen",
            "ts-node",
            "tsconfig-paths",
            "typescript",
            "@aws-cdk/aws-pipes-alpha",
            "@aws-cdk/aws-pipes-sources-alpha",
            "@aws-cdk/aws-pipes-targets-alpha",
            "@aws-lambda-powertools/batch",
            "@aws-lambda-powertools/logger",
            "@aws-lambda-powertools/parameters",
            "@aws-lambda-powertools/parser",
            "@aws-lambda-powertools/tracer",
            "@aws-lambda-powertools/validation",
            "@aws-sdk/client-dynamodb",
            "@aws-sdk/client-eventbridge",
            "@aws-sdk/client-secrets-manager",
            "@aws-sdk/lib-dynamodb",
            "@middy/core",
            "aws-cdk-lib",
            "axios",
            "axios-retry",
            "constructs",
            "tweetnacl",
            "zod"
          ]
        },
        {
          "exec": "bunx projen"
        },
        {
          "spawn": "post-upgrade"
        }
      ]
    },
    "watch": {
      "name": "watch",
      "description": "Watches changes in your source code and rebuilds and deploys to the current account",
      "steps": [
        {
          "execArgs": [
            "cdk",
            "deploy",
            "--hotswap"
          ]
        },
        {
          "execArgs": [
            "cdk",
            "watch"
          ]
        }
      ]
    }
  },
  "//": "~~ Generated by projen. To modify, edit .projenrc.ts and run \"bunx projen\"."
}
